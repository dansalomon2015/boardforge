# Shared local URLs
PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Use "openai" for live AI generation, or "fake" for the deterministic local compiler.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
# Optional lower-cost model for critique, review and patch workflows.
OPENAI_REVIEW_MODEL=gpt-5.6-luna
LLM_PROVIDER=openai

# PostgreSQL persists immutable blueprint revisions and virtual-agent playtest reports.
DATABASE_URL=postgresql://boardforge:boardforge@localhost:5433/boardforge
# Set true in hosted environments to fail startup instead of falling back to memory.
DATABASE_REQUIRED=false
