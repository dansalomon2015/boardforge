{
  "name": "boardforge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @boardforge/server --filter @boardforge/web dev",
    "build": "pnpm -r build",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint . && pnpm -r lint",
    "deadcode": "knip",
    "coverage": "vitest run --coverage --passWithNoTests",
    "test": "pnpm -r test",
    "smoke:multiplayer": "pnpm --dir apps/web exec node scripts/multiplayer-smoke.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm deadcode && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "latest",
    "@vitest/coverage-v8": "^4.1.10",
    "knip": "^6.27.0",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
