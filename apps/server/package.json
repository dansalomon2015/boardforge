{
  "name": "@boardforge/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run src --passWithNoTests"
  },
  "dependencies": {
    "@boardforge/game-engine": "workspace:*",
    "@boardforge/game-spec": "workspace:*",
    "@boardforge/llm": "workspace:*",
    "@boardforge/shared": "workspace:*",
    "@fastify/cors": "latest",
    "dotenv": "latest",
    "fastify": "latest",
    "pg": "latest",
    "socket.io": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/pg": "latest",
    "socket.io-client": "^4.8.3",
    "tsx": "latest",
    "typescript": "5.9.3",
    "vitest": "latest"
  }
}
